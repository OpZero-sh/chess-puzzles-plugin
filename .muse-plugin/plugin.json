{
  "schemaVersion": 1,
  "name": "chess-puzzles",
  "version": "1.0.0",
  "displayName": "Chess Puzzles",
  "description": "Practice chess tactics one move at a time with rated Lichess puzzles, graduated hints and a daily challenge.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "tactics-practice",
        "path": "skills/tactics-practice/SKILL.md"
      }
    ],
    "mcpServers": [
      {
        "id": "chess-puzzles",
        "transport": "http",
        "url": "https://chess-puzzles.mcp.opzero.sh/mcp"
      }
    ]
  }
}
